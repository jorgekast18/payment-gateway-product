{
  "name": "payment-gateway-product",
  "version": "1.0.0",
  "private": true,
  "description": "Product checkout with credit card payment through a payment gateway",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "npm run start:dev --workspace apps/api",
    "web": "npm run dev --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
