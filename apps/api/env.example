# Copy this file to .env and fill in the values.
# API
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout?schema=public

# Pricing (integer cents)
BASE_FEE_IN_CENTS=200000
DELIVERY_FEE_IN_CENTS=1500000

# Payment gateway (sandbox). Values are injected per environment and never committed.
PAYMENT_API_URL=https://payment-gateway.example/v1
PAYMENT_PUBLIC_KEY=pub_replace_me
PAYMENT_PRIVATE_KEY=prv_replace_me
PAYMENT_INTEGRITY_SECRET=integrity_replace_me
PAYMENT_CURRENCY=COP
PAYMENT_TOKENIZE_PATH=/tokens/cards
PAYMENT_INSTALLMENTS=1
